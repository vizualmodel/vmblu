{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vmblu.dev/context/1.12.0/model-test.schema.json",
  "title": "vmblu Model Test",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "kind", "version", "schemaVersion", "source", "target", "host", "scenarios"],
  "properties": {
    "$schema": { "const": "https://vmblu.dev/context/1.12.0/model-test.schema.json" },
    "kind": { "const": "vmblu.model-test" },
    "version": { "const": 1 },
    "schemaVersion": { "const": "1.12.0" },
    "source": { "$ref": "#/$defs/Source" },
    "target": { "$ref": "#/$defs/Target" },
    "host": { "enum": ["node", "browser"] },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Scenario" }
    }
  },
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^fnv1a64:[0-9a-f]{16}$"
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "spec", "specHash", "contractHash"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "spec": { "type": "string", "minLength": 1 },
        "specHash": { "$ref": "#/$defs/Hash" },
        "contractHash": { "$ref": "#/$defs/Hash" }
      }
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "name", "path"],
      "properties": {
        "scope": { "enum": ["node", "group", "model"] },
        "name": { "type": "string", "minLength": 1 },
        "path": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "Locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "css": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 }
      },
      "oneOf": [
        { "required": ["css"] },
        { "required": ["role"] }
      ]
    },
    "SendAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pin", "message"],
      "properties": {
        "kind": { "const": "send" },
        "pin": { "type": "string", "minLength": 1 },
        "message": {}
      }
    },
    "RequestAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pin", "message"],
      "properties": {
        "kind": { "const": "request" },
        "pin": { "type": "string", "minLength": 1 },
        "message": {}
      }
    },
    "MountAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pin"],
      "properties": {
        "kind": { "const": "mount" },
        "pin": { "type": "string", "minLength": 1 },
        "message": {}
      }
    },
    "ClickAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": { "const": "click" },
        "locator": { "$ref": "#/$defs/Locator" }
      }
    },
    "FillAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "value"],
      "properties": {
        "kind": { "const": "fill" },
        "locator": { "$ref": "#/$defs/Locator" },
        "value": { "type": "string" }
      }
    },
    "WaitAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ms"],
      "properties": {
        "kind": { "const": "wait" },
        "ms": { "type": "integer", "minimum": 0 }
      }
    },
    "Action": {
      "oneOf": [
        { "$ref": "#/$defs/SendAction" },
        { "$ref": "#/$defs/RequestAction" },
        { "$ref": "#/$defs/MountAction" },
        { "$ref": "#/$defs/ClickAction" },
        { "$ref": "#/$defs/FillAction" },
        { "$ref": "#/$defs/WaitAction" }
      ]
    },
    "MessageExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pin", "message"],
      "properties": {
        "kind": { "enum": ["send", "reply"] },
        "pin": { "type": "string", "minLength": 1 },
        "message": {},
        "count": { "type": "integer", "minimum": 0, "default": 1 }
      }
    },
    "ViewExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": { "const": "view" },
        "locator": { "$ref": "#/$defs/Locator" },
        "count": { "type": "integer", "minimum": 0 },
        "text": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "class": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "visible": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["count"] },
        { "required": ["text"] },
        { "required": ["class"] },
        { "required": ["visible"] }
      ]
    },
    "Expectation": {
      "oneOf": [
        { "$ref": "#/$defs/MessageExpectation" },
        { "$ref": "#/$defs/ViewExpectation" }
      ]
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "actions", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 0, "default": 1000 },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Action" }
        },
        "expect": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Expectation" }
        }
      }
    }
  }
}
