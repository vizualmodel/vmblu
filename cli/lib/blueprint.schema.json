{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vmblu Blueprint convention v1 (provisional)",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "name", "summary", "author", "license", "vmblu", "readme", "models"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "licenseFile": {"$ref": "#/definitions/path"},
    "vmblu": {"type": "string", "minLength": 1},
    "readme": {"$ref": "#/definitions/path"},
    "models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/path"}},
    "media": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/path"}},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "definitions": {"path": {"type": "string", "minLength": 1}}
}
