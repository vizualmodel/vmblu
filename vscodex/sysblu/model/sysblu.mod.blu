  "types": {
    "AnyPayload": {
      "kind": "primitive",
      "summary": "Opaque host or UI payload."
    },
    "Void": {
      "kind": "object",
      "summary": "No payload.",
      "fields": {}
    },
    "ArlRef": {
      "kind": "external",
      "summary": "Workspace or model path reference.",
      "external": {
        "library": "kernel",
        "symbol": "ARL"
      }
    },
    "DomElement": {
      "kind": "external",
      "summary": "Browser DOM element composed by the webview host.",
      "external": {
        "library": "browser",
        "symbol": "HTMLElement"
      }
    },
    "StringList": {
      "kind": "array",
      "summary": "Ordered diagnostic messages.",
      "items": {
        "vmbluType": "string"
      }
    },
    "SystemDiagnostics": {
      "kind": "object",
      "summary": "Validation diagnostics for the active system document.",
      "fields": {
        "arl": {
          "vmbluType": "ArlRef"
        },
        "errors": {
          "vmbluType": "StringList"
        }
      },
      "required": [
        "errors"
      ]
    },
    "ViewSize": {
      "kind": "object",
      "summary": "Available canvas size in CSS pixels.",
      "fields": {
        "w": {
          "vmbluType": "number"
        },
        "h": {
          "vmbluType": "number"
        },
        "dpr": {
          "vmbluType": "number"
        }
      },
      "required": [
        "w",
        "h"
      ]
    },
    "ActiveDocument": {
      "kind": "object",
      "summary": "System document selected by the VS Code host.",
      "fields": {
        "kind": {
          "vmbluType": "string"
        },
        "arl": {
          "vmbluType": "ArlRef"
        },
        "model": {
          "vmbluType": "AnyPayload"
        }
      },
      "required": [
        "kind",
        "arl"
      ]
    },
    "SystemSnapshot": {
      "kind": "object",
      "summary": "Current system document and dirty state.",
      "fields": {
        "document": {
          "vmbluType": "AnyPayload"
        },
        "arl": {
          "vmbluType": "ArlRef"
        },
        "dirty": {
          "vmbluType": "boolean"
        }
      },
      "required": [
        "document",
        "dirty"
      ]
    },
    "CommandRequest": {
      "kind": "object",
      "summary": "Terminal command requested for trusted host execution.",
      "fields": {
        "command": {
          "vmbluType": "string"
        },
        "workingDirectory": {
          "vmbluType": "ArlRef"
        }
      },
      "required": [
        "command",
        "workingDirectory"
      ]
    }
  },
