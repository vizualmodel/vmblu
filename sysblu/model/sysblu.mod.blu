  ],
  "types": {
    "AnyPayload": {
      "kind": "primitive",
      "summary": "Opaque payload whose detailed structure is not yet stabilized."
    },
    "Void": {
      "kind": "object",
      "summary": "No payload.",
      "fields": {}
    },
    "ArlRef": {
      "kind": "external",
      "summary": "Workspace or model path reference.",
      "external": {
        "library": "kernel",
        "symbol": "ARL"
      }
    },
    "StringList": {
      "kind": "array",
      "summary": "Ordered diagnostic messages.",
      "items": {
        "vmbluType": "string"
      }
    },
    "SystemDiagnostics": {
      "kind": "object",
      "summary": "Validation diagnostics for the active system document.",
      "fields": {
        "arl": {
          "vmbluType": "ArlRef"
        },
        "errors": {
          "vmbluType": "StringList"
        }
      },
      "required": [
        "errors"
      ]
    },
    "CommandRequest": {
      "kind": "object",
      "summary": "Terminal command request for execution by a trusted host.",
      "fields": {
        "command": {
          "vmbluType": "string"
        },
        "workingDirectory": {
          "vmbluType": "ArlRef"
        }
      },
      "required": [
        "command",
        "workingDirectory"
      ]
    },
    "ActiveDocument": {
      "kind": "object",
      "summary": "Active system document selected by the host document manager.",
      "fields": {
        "kind": {
          "vmbluType": "string"
        },
        "arl": {
          "vmbluType": "ArlRef"
        },
        "model": {
          "vmbluType": "AnyPayload"
        }
      },
      "required": [
        "kind",
        "arl"
      ]
    },
    "SystemDocument": {
      "kind": "primitive",
      "summary": "Schema-valid sysblu system configuration supplied as one opaque document value."
    },
    "SystemSnapshot": {
      "kind": "object",
      "summary": "Immutable view snapshot of the active system document and its source reference.",
      "fields": {
        "document": {
          "vmbluType": "SystemDocument"
        },
        "arl": {
          "vmbluType": "ArlRef"
        },
        "dirty": {
          "vmbluType": "boolean"
        }
      },
      "required": [
        "document",
        "dirty"
      ]
    },
    "ViewSize": {
      "kind": "object",
      "summary": "Canvas size update in CSS pixels with an optional device-pixel ratio.",
      "fields": {
        "w": {
          "vmbluType": "number"
        },
        "h": {
          "vmbluType": "number"
        },
        "dpr": {
          "vmbluType": "number"
        }
      },
      "required": [
        "w",
        "h"
      ]
    },
    "SysmodDoit": {
      "kind": "object",
      "summary": "Command requesting one reversible change to the active system document.",
      "fields": {
        "verb": {
          "vmbluType": "string"
        },
        "param": {
          "vmbluType": "AnyPayload"
        }
      },
      "required": [
        "verb"
      ]
    },
    "SysmodDone": {
      "kind": "object",
      "summary": "Notification that a sysmod action finished and the resulting history state.",
      "fields": {
        "verb": {
          "vmbluType": "string"
        },
        "undo": {
          "vmbluType": "boolean"
        },
        "redo": {
          "vmbluType": "boolean"
        },
        "dirty": {
          "vmbluType": "boolean"
        },
        "error": {
          "vmbluType": "string"
        }
      },
      "required": [
        "verb",
        "undo",
        "redo",
        "dirty"
      ]
    },
    "ApplicationInspectorRequest": {
      "kind": "primitive",
      "summary": "UI request containing an application snapshot, popup placement, and completion callback."
    },
    "EndpointInspectorRequest": {
      "kind": "primitive",
      "summary": "UI request containing an endpoint snapshot, popup placement, and completion callback."
    },
    "ConnectionInspectorRequest": {
      "kind": "primitive",
      "summary": "UI request containing a system connection snapshot, popup placement, and completion callback."
    }
  },
